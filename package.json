{
  "name": "wx-electron-intel-chat",
  "productName": "wx-electron-intel-chat",
  "version": "1.1.1",
  "description": "My Electron application description",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "web": "vite --config vite.renderer.config.mts",
    "dev:electron": "electron .",
    "start": "concurrently \"npm run web \" \"npm run dev:electron\"",
    "build:main": "node build/build-main.js",
    "build:renderer": "vite build --config vite.renderer.config.mts",
    "package": "npm run build:main && npm run build:renderer",
    "make": "npm run package && electron-builder",
    "publish": "npm run make && dotenv -e .env -- electron-builder --publish always",
    "ci:publish": "npm run make && electron-builder --publish always",
    "build-icon": "electron-icon-builder --input=./src/assets/icon.png --output=./src/assets",
    "lint:check": "eslint --ext .ts,.tsx,.js,.vue",
    "lint:fix": "npm run lint:check -- --fix",
    "prettier:check": "prettier **/*.{json,css,scss,md,yml,yaml} --check",
    "prettier:fix": "prettier **/*.{json,css,scss,md,yml,yaml} --write",
    "ci:lint": "npm run lint:check && npm run prettier:check",
    "prepare": "husky"
  },
  "build": {
    "extends": "./electron-builder.yml"
  },
  "keywords": [],
  "author": {
    "name": "wuzhenhua",
    "email": "15240021857@139.com"
  },
  "license": "MIT",
  "lint-staged": {
    "*.{ts,tsx,js,vue}": [
      "npm run lint:fix"
    ],
    "*.{json,css,scss,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@types/electron-squirrel-startup": "^1.0.2",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.3",
    "dotenv-cli": "^11.0.0",
    "electron": "41.0.0",
    "electron-builder": "^26.15.3",
    "electron-icon-builder": "^2.0.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-vue": "^9.28.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.8",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.2.1",
    "typescript": "~4.5.4",
    "vite": "^5.4.21",
    "vue-eslint-parser": "^9.4.3"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.0",
    "@internationalized/number": "^3.6.7",
    "@radix-ui/colors": "^3.0.0",
    "@tailwindcss/vite": "^4.2.1",
    "@vueuse/core": "^14.3.0",
    "dayjs": "^1.11.21",
    "dexie": "^4.4.4",
    "dotenv": "^17.4.2",
    "electron-squirrel-startup": "^1.0.1",
    "marked": "^18.0.2",
    "openai": "^6.34.0",
    "pinia": "^3.0.4",
    "reka-ui": "^2.9.2",
    "uuid": "^14.0.0",
    "vue": "^3.5.30",
    "vue-i18n": "^11.4.6",
    "vue-router": "^4.6.4"
  }
}
